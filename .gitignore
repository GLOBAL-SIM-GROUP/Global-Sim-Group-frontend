# ── Dépendances ──────────────────────────────────────────────
node_modules
# npm est le gestionnaire du projet (package-lock.json versionné) —
# empêcher les commits accidentels d'un autre PM.
yarn.lock
pnpm-lock.yaml

# ── Build / cache de dev ─────────────────────────────────────
dist
dist-ssr
.nitro
.tanstack
.vite
.wrangler
.output
.vinxi
*.tsbuildinfo

# ── Déploiement ──────────────────────────────────────────────
# `vercel pull`/`vercel dev` y déposent la config projet ET les
# variables d'environnement en clair — ne jamais committer.
.vercel/

# ── Environnement local (NON commités). `.env.example` reste versionné. ──
.env
.env.*
!.env.example
*.local

# ── Certificats / clés (garde-fou — jamais de secret dans le repo) ──
*.pem
*.pfx
*.p12
id_rsa*

# ── Tests ────────────────────────────────────────────────────
coverage
# Sorties Playwright (captures de guides + specs e2e)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Artéfacts de compilation LaTeX (docs/guides-utilisation) ─
# Les .tex, .png (captures) et .pdf finaux restent versionnés ;
# seuls les intermédiaires de build sont ignorés.
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.xdv

# ── Snapshot OpenAPI local (régénéré) — ne PAS committer ─────
scripts/openapi.latest.json

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ───────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Éditeurs / outils IA ─────────────────────────────────────
.idea/
# On versionne settings.json (formateur/coloration partagés), pas les
# préférences personnelles (launch.json, extensions.json…).
.vscode/*
!.vscode/settings.json
# Config agents/éditeurs personnels — la config partagée vit dans .devin/.
.cursor/
.claude/

# ── Divers ───────────────────────────────────────────────────
__unconfig*
todos.json
# Restes de résolution de conflits git.
*.orig
# `prod-server.mjs` lancé en arrière-plan avec nohup.
nohup.out
